HOST=localhost
PORT=8080
# Web dev server origin(s) allowed by CORS, comma separated
ALLOWED_ORIGINS=http://localhost:5173

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tabulation
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# goose CLI (paths are relative to server/, where db tasks run)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=${DATABASE_URL}
GOOSE_MIGRATION_DIR=migrations

# development | production
APP_ENV=development
LOG_LEVEL=info

# HS256 signing key for login cookies. Generate one: openssl rand -hex 32
JWT_SECRET=change-me
# Secure session cookie (https only). Defaults to true when APP_ENV=production
# COOKIE_SECURE=false

# First admin, created by `mise run seed` (password 8+ chars)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
