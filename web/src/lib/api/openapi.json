{
	"components": {
		"schemas": {
			"Board": {
				"additionalProperties": false,
				"properties": {
					"candidates": {
						"items": { "$ref": "#/components/schemas/BoardCandidate" },
						"type": ["array", "null"]
					},
					"judge_id": { "type": "string" }
				},
				"required": ["judge_id", "candidates"],
				"type": "object"
			},
			"BoardCandidate": {
				"additionalProperties": false,
				"properties": {
					"first_name": { "type": "string" },
					"id": { "type": "string" },
					"last_name": { "type": "string" },
					"my_scores": {
						"items": { "$ref": "#/components/schemas/ScoreValue" },
						"type": ["array", "null"]
					},
					"number": { "format": "int64", "type": "integer" },
					"scored_by": { "type": "string" },
					"status": { "enum": ["unscored", "scored", "scored_by_other"], "type": "string" },
					"total": { "format": "int64", "type": "integer" }
				},
				"required": ["id", "number", "first_name", "last_name", "status", "my_scores"],
				"type": "object"
			},
			"Candidate": {
				"additionalProperties": false,
				"properties": {
					"created_at": { "format": "date-time", "type": "string" },
					"first_name": { "type": "string" },
					"id": { "type": "string" },
					"last_name": { "type": "string" },
					"number": { "format": "int64", "type": "integer" },
					"updated_at": { "format": "date-time", "type": "string" }
				},
				"required": ["id", "number", "first_name", "last_name", "created_at", "updated_at"],
				"type": "object"
			},
			"CandidateUpdateInput": {
				"additionalProperties": false,
				"properties": {
					"first_name": { "maxLength": 100, "minLength": 1, "type": "string" },
					"last_name": { "maxLength": 100, "minLength": 1, "type": "string" },
					"number": { "format": "int64", "minimum": 1, "type": "integer" }
				},
				"type": "object"
			},
			"Criterion": {
				"additionalProperties": false,
				"properties": {
					"description": { "type": "string" },
					"id": { "type": "string" },
					"max_points": {
						"format": "int32",
						"maximum": 32767,
						"minimum": -32768,
						"type": "integer"
					},
					"position": { "format": "int32", "maximum": 32767, "minimum": -32768, "type": "integer" },
					"title": { "type": "string" }
				},
				"required": ["id", "title", "description", "max_points", "position"],
				"type": "object"
			},
			"CriterionInput": {
				"additionalProperties": false,
				"properties": {
					"description": { "maxLength": 1000, "type": "string" },
					"id": { "format": "uuid", "type": "string" },
					"max_points": { "format": "int32", "maximum": 100, "minimum": 1, "type": "integer" },
					"title": { "maxLength": 200, "minLength": 1, "type": "string" }
				},
				"required": ["title", "description", "max_points"],
				"type": "object"
			},
			"ErrorDetail": {
				"additionalProperties": false,
				"properties": {
					"location": {
						"description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
						"type": "string"
					},
					"message": { "description": "Error message text", "type": "string" },
					"value": { "description": "The value at the given location" }
				},
				"type": "object"
			},
			"ErrorModel": {
				"additionalProperties": false,
				"properties": {
					"detail": {
						"description": "A human-readable explanation specific to this occurrence of the problem.",
						"examples": ["Property foo is required but is missing."],
						"type": "string"
					},
					"errors": {
						"description": "Optional list of individual error details",
						"items": { "$ref": "#/components/schemas/ErrorDetail" },
						"type": ["array", "null"]
					},
					"instance": {
						"description": "A URI reference that identifies the specific occurrence of the problem.",
						"examples": ["https://example.com/error-log/abc123"],
						"format": "uri",
						"type": "string"
					},
					"status": {
						"description": "HTTP status code",
						"examples": [400],
						"format": "int64",
						"type": "integer"
					},
					"title": {
						"description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
						"examples": ["Bad Request"],
						"type": "string"
					},
					"type": {
						"default": "about:blank",
						"description": "A URI reference to human-readable documentation for the error.",
						"examples": ["https://example.com/errors/example"],
						"format": "uri",
						"type": "string"
					}
				},
				"type": "object"
			},
			"Event": {
				"additionalProperties": false,
				"properties": {
					"interviewId": { "type": "string" },
					"topic": {
						"enum": ["scores", "candidates", "rubrics", "interviews", "users"],
						"type": "string"
					}
				},
				"required": ["topic"],
				"type": "object"
			},
			"HealthOutputBody": {
				"additionalProperties": false,
				"properties": { "status": { "examples": ["ok"], "type": "string" } },
				"required": ["status"],
				"type": "object"
			},
			"ImportOutputBody": {
				"additionalProperties": false,
				"properties": {
					"dry_run": { "type": "boolean" },
					"errors": { "format": "int64", "type": "integer" },
					"rows": {
						"items": { "$ref": "#/components/schemas/ImportRow" },
						"type": ["array", "null"]
					}
				},
				"required": ["dry_run", "rows", "errors"],
				"type": "object"
			},
			"ImportRow": {
				"additionalProperties": false,
				"properties": {
					"error": { "type": "string" },
					"first_name": { "type": "string" },
					"last_name": { "type": "string" },
					"line": { "format": "int64", "type": "integer" },
					"number": { "format": "int64", "type": "integer" }
				},
				"required": ["line", "first_name", "last_name"],
				"type": "object"
			},
			"Interview": {
				"additionalProperties": false,
				"properties": {
					"created_at": { "format": "date-time", "type": "string" },
					"description": { "type": "string" },
					"has_scores": { "type": "boolean" },
					"id": { "type": "string" },
					"judges": {
						"items": { "$ref": "#/components/schemas/JudgeInfo" },
						"type": ["array", "null"]
					},
					"mode": { "enum": ["one_on_one", "panel"], "type": "string" },
					"position": { "format": "int32", "maximum": 32767, "minimum": -32768, "type": "integer" },
					"rubric_id": { "type": "string" },
					"rubric_name": { "type": "string" },
					"title": { "type": "string" },
					"updated_at": { "format": "date-time", "type": "string" }
				},
				"required": [
					"id",
					"rubric_id",
					"rubric_name",
					"title",
					"description",
					"mode",
					"position",
					"created_at",
					"updated_at",
					"has_scores",
					"judges"
				],
				"type": "object"
			},
			"InterviewCreateInput": {
				"additionalProperties": false,
				"properties": {
					"description": { "maxLength": 1000, "type": "string" },
					"judge_user_ids": {
						"description": "User ids to assign as judges.",
						"items": { "format": "uuid", "type": "string" },
						"type": ["array", "null"]
					},
					"mode": { "enum": ["one_on_one", "panel"], "type": "string" },
					"rubric_id": { "format": "uuid", "type": "string" },
					"title": { "maxLength": 200, "minLength": 1, "type": "string" }
				},
				"required": ["title", "description", "mode", "rubric_id"],
				"type": "object"
			},
			"InterviewUpdateInput": {
				"additionalProperties": false,
				"properties": {
					"description": { "maxLength": 1000, "type": "string" },
					"mode": { "enum": ["one_on_one", "panel"], "type": "string" },
					"rubric_id": { "format": "uuid", "type": "string" },
					"title": { "maxLength": 200, "minLength": 1, "type": "string" }
				},
				"type": "object"
			},
			"JudgeInfo": {
				"additionalProperties": false,
				"properties": {
					"first_name": { "type": "string" },
					"judge_id": { "type": "string" },
					"last_name": { "type": "string" },
					"scored": { "format": "int64", "type": "integer" },
					"user_id": { "type": "string" }
				},
				"required": ["judge_id", "user_id", "first_name", "last_name", "scored"],
				"type": "object"
			},
			"LoginInputBody": {
				"additionalProperties": false,
				"properties": {
					"password": { "minLength": 1, "type": "string" },
					"username": { "minLength": 1, "type": "string" }
				},
				"required": ["username", "password"],
				"type": "object"
			},
			"MyCriterion": {
				"additionalProperties": false,
				"properties": {
					"description": { "type": "string" },
					"id": { "type": "string" },
					"max_points": {
						"format": "int32",
						"maximum": 32767,
						"minimum": -32768,
						"type": "integer"
					},
					"title": { "type": "string" }
				},
				"required": ["id", "title", "description", "max_points"],
				"type": "object"
			},
			"MyInterview": {
				"additionalProperties": false,
				"properties": {
					"candidate_count": { "format": "int64", "type": "integer" },
					"description": { "type": "string" },
					"id": { "type": "string" },
					"judge_id": { "type": "string" },
					"mode": { "enum": ["one_on_one", "panel"], "type": "string" },
					"rubric": { "$ref": "#/components/schemas/MyRubric" },
					"title": { "type": "string" }
				},
				"required": ["id", "judge_id", "title", "description", "mode", "candidate_count", "rubric"],
				"type": "object"
			},
			"MyRubric": {
				"additionalProperties": false,
				"properties": {
					"criteria": {
						"items": { "$ref": "#/components/schemas/MyCriterion" },
						"type": ["array", "null"]
					},
					"id": { "type": "string" },
					"name": { "type": "string" }
				},
				"required": ["id", "name", "criteria"],
				"type": "object"
			},
			"NameInput": {
				"additionalProperties": false,
				"properties": {
					"first_name": { "maxLength": 100, "minLength": 1, "type": "string" },
					"last_name": { "maxLength": 100, "minLength": 1, "type": "string" },
					"number": { "format": "int64", "minimum": 1, "type": "integer" }
				},
				"required": ["first_name", "last_name"],
				"type": "object"
			},
			"Reorder-interviewsRequest": {
				"additionalProperties": false,
				"properties": {
					"ids": { "items": { "format": "uuid", "type": "string" }, "type": ["array", "null"] }
				},
				"required": ["ids"],
				"type": "object"
			},
			"ResetPasswordInputBody": {
				"additionalProperties": false,
				"properties": { "password": { "maxLength": 72, "minLength": 8, "type": "string" } },
				"required": ["password"],
				"type": "object"
			},
			"ResultCandidate": {
				"additionalProperties": false,
				"properties": {
					"average": { "format": "double", "type": "number" },
					"complete": { "type": "boolean" },
					"first_name": { "type": "string" },
					"id": { "type": "string" },
					"last_name": { "type": "string" },
					"number": { "format": "int64", "type": "integer" },
					"submissions": {
						"items": { "$ref": "#/components/schemas/Submission" },
						"type": ["array", "null"]
					},
					"sum": { "format": "int64", "type": "integer" }
				},
				"required": ["id", "number", "first_name", "last_name", "submissions", "sum", "complete"],
				"type": "object"
			},
			"ResultCriterion": {
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string" },
					"max_points": {
						"format": "int32",
						"maximum": 32767,
						"minimum": -32768,
						"type": "integer"
					},
					"title": { "type": "string" }
				},
				"required": ["id", "title", "max_points"],
				"type": "object"
			},
			"ResultInterview": {
				"additionalProperties": false,
				"properties": {
					"criteria": {
						"items": { "$ref": "#/components/schemas/ResultCriterion" },
						"type": ["array", "null"]
					},
					"id": { "type": "string" },
					"judges": {
						"items": { "$ref": "#/components/schemas/ResultJudge" },
						"type": ["array", "null"]
					},
					"mode": { "enum": ["one_on_one", "panel"], "type": "string" },
					"selected": { "type": "boolean" },
					"title": { "type": "string" }
				},
				"required": ["id", "title", "mode", "selected", "judges", "criteria"],
				"type": "object"
			},
			"ResultJudge": {
				"additionalProperties": false,
				"properties": { "judge_id": { "type": "string" }, "name": { "type": "string" } },
				"required": ["judge_id", "name"],
				"type": "object"
			},
			"Results": {
				"additionalProperties": false,
				"properties": {
					"candidates": {
						"items": { "$ref": "#/components/schemas/ResultCandidate" },
						"type": ["array", "null"]
					},
					"expected": { "format": "int64", "type": "integer" },
					"fully_scored": { "format": "int64", "type": "integer" },
					"interviews": {
						"items": { "$ref": "#/components/schemas/ResultInterview" },
						"type": ["array", "null"]
					}
				},
				"required": ["interviews", "candidates", "expected", "fully_scored"],
				"type": "object"
			},
			"Rubric": {
				"additionalProperties": false,
				"properties": {
					"created_at": { "format": "date-time", "type": "string" },
					"criteria": {
						"items": { "$ref": "#/components/schemas/Criterion" },
						"type": ["array", "null"]
					},
					"id": { "type": "string" },
					"locked": { "type": "boolean" },
					"name": { "type": "string" },
					"updated_at": { "format": "date-time", "type": "string" },
					"used_by": { "items": { "type": "string" }, "type": ["array", "null"] }
				},
				"required": ["id", "name", "created_at", "updated_at", "locked", "used_by", "criteria"],
				"type": "object"
			},
			"SaveInput": {
				"additionalProperties": false,
				"properties": {
					"criteria": {
						"items": { "$ref": "#/components/schemas/CriterionInput" },
						"maxItems": 50,
						"minItems": 1,
						"type": ["array", "null"]
					},
					"name": { "maxLength": 200, "minLength": 1, "type": "string" }
				},
				"required": ["name", "criteria"],
				"type": "object"
			},
			"ScoreValue": {
				"additionalProperties": false,
				"properties": {
					"criterion_id": { "format": "uuid", "type": "string" },
					"value": { "format": "int32", "maximum": 32767, "minimum": 0, "type": "integer" }
				},
				"required": ["criterion_id", "value"],
				"type": "object"
			},
			"Set-interview-judgesRequest": {
				"additionalProperties": false,
				"properties": {
					"user_ids": { "items": { "format": "uuid", "type": "string" }, "type": ["array", "null"] }
				},
				"required": ["user_ids"],
				"type": "object"
			},
			"Submission": {
				"additionalProperties": false,
				"properties": {
					"edited_at": { "format": "date-time", "type": "string" },
					"interview_id": { "type": "string" },
					"judge_id": { "type": "string" },
					"judge_name": { "type": "string" },
					"submitted_at": { "format": "date-time", "type": "string" },
					"total": { "format": "int64", "type": "integer" },
					"values": {
						"items": { "$ref": "#/components/schemas/SubmissionValue" },
						"type": ["array", "null"]
					}
				},
				"required": [
					"interview_id",
					"judge_id",
					"judge_name",
					"total",
					"values",
					"submitted_at",
					"edited_at"
				],
				"type": "object"
			},
			"SubmissionValue": {
				"additionalProperties": false,
				"properties": {
					"criterion_id": { "type": "string" },
					"value": { "format": "int32", "maximum": 32767, "minimum": -32768, "type": "integer" }
				},
				"required": ["criterion_id", "value"],
				"type": "object"
			},
			"SubmitInput": {
				"additionalProperties": false,
				"properties": {
					"scores": {
						"items": { "$ref": "#/components/schemas/ScoreValue" },
						"maxItems": 50,
						"type": ["array", "null"]
					}
				},
				"required": ["scores"],
				"type": "object"
			},
			"User": {
				"additionalProperties": false,
				"properties": {
					"created_at": { "format": "date-time", "type": "string" },
					"first_name": { "type": "string" },
					"id": { "type": "string" },
					"last_name": { "type": "string" },
					"role": { "enum": ["admin", "judge"], "type": "string" },
					"updated_at": { "format": "date-time", "type": "string" },
					"username": { "type": "string" }
				},
				"required": [
					"id",
					"username",
					"role",
					"first_name",
					"last_name",
					"created_at",
					"updated_at"
				],
				"type": "object"
			},
			"UserCreateInput": {
				"additionalProperties": false,
				"properties": {
					"first_name": { "maxLength": 100, "minLength": 1, "type": "string" },
					"last_name": { "maxLength": 100, "minLength": 1, "type": "string" },
					"password": { "maxLength": 72, "minLength": 8, "type": "string" },
					"role": { "enum": ["admin", "judge"], "type": "string" },
					"username": {
						"maxLength": 50,
						"minLength": 3,
						"pattern": "^[A-Za-z0-9._-]+$",
						"type": "string"
					}
				},
				"required": ["username", "password", "role", "first_name", "last_name"],
				"type": "object"
			},
			"UserUpdateInput": {
				"additionalProperties": false,
				"properties": {
					"first_name": { "maxLength": 100, "minLength": 1, "type": "string" },
					"last_name": { "maxLength": 100, "minLength": 1, "type": "string" },
					"role": { "enum": ["admin", "judge"], "type": "string" },
					"username": {
						"maxLength": 50,
						"minLength": 3,
						"pattern": "^[A-Za-z0-9._-]+$",
						"type": "string"
					}
				},
				"type": "object"
			}
		}
	},
	"info": { "title": "Interview Tabulation API", "version": "0.1.0" },
	"openapi": "3.1.0",
	"paths": {
		"/health": {
			"get": {
				"operationId": "health",
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/HealthOutputBody" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Health check"
			}
		},
		"/v1/auth/login": {
			"post": {
				"description": "Checks username and password and sets the session cookie.",
				"operationId": "login",
				"requestBody": {
					"content": {
						"application/json": { "schema": { "$ref": "#/components/schemas/LoginInputBody" } }
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/User" } }
						},
						"description": "OK",
						"headers": { "Set-Cookie": { "schema": { "type": "string" } } }
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Log in",
				"tags": ["Authentication"]
			}
		},
		"/v1/auth/logout": {
			"post": {
				"description": "Clears the session cookie.",
				"operationId": "logout",
				"responses": {
					"204": {
						"description": "No Content",
						"headers": { "Set-Cookie": { "schema": { "type": "string" } } }
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Log out",
				"tags": ["Authentication"]
			}
		},
		"/v1/auth/me": {
			"get": {
				"operationId": "me",
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/User" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Current user",
				"tags": ["Authentication"]
			}
		},
		"/v1/candidates": {
			"get": {
				"operationId": "list-candidates",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"items": { "$ref": "#/components/schemas/Candidate" },
									"type": ["array", "null"]
								}
							}
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
